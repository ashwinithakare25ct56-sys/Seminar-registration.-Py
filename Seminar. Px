# Add Seminar
def add_seminar():
    name = seminar_name_entry.get()
    speaker = speaker_entry.get()
    date = date_entry.get()
    time = time_entry.get()
    venue = venue_entry.get()
    seats = seats_entry.get()

    if name == "" or speaker == "" or date == "" or time == "" or venue == "" or seats == "":
        messagebox.showwarning("Warning", "Please fill all fields")
        return

    db = connect_database()
    cursor = db.cursor()

    query = """ INSERT INTO seminars (seminar_name, speaker, seminar_date, seminar_time, venue, seats) VALUES (%s, %s, %s, %s, %s, %s) """

    cursor.execute(query, (name, speaker, date, time, venue, seats))
    db.commit()

    cursor.close()
    db.close()

    messagebox.showinfo("Success", "Seminar added successfully!")
    clear_seminar_fields()


