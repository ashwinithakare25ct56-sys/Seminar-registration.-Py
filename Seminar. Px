# View seminars
def view_seminars():
    db = connect_database()
    cursor = db.cursor()

    cursor.execute("SELECT * FROM seminars")
    records = cursor.fetchall()

    cursor.close()
    db.close()

    window = tk.Toplevel()
    window.title("All Seminars")
    window.geometry("900x400")

    columns = (
        "ID",
        "Seminar Name",
        "Speaker",
        "Date",
        "Time",
        "Venue",
        "Seats"
    )

    table = ttk.Treeview(window, columns=columns, show="headings")

    for column in columns:
        table.heading(column, text=column)
        table.column(column, width=120)

    for record in records:
        table.insert("", tk.END, values=record)

    table.pack(fill="both", expand=True)


# Student registration
def register_student():
    student_id = student_id_entry.get()
    student_name = student_name_entry.get()
    department = department_entry.get()
    email = email_entry.get()
    phone = phone_entry.get()
    seminar_id = seminar_id_entry.get()

    if (student_id == "" or student_name == "" or department == "" or
            email == "" or phone == "" or seminar_id == ""):
        messagebox.showwarning("Warning", "Please fill all fields")
        return

    db = connect_database()
    cursor = db.cursor()

    # Check seminar
    cursor.execute(
        "SELECT seats FROM seminars WHERE seminar_id = %s",
        (seminar_id,)
    )

    seminar = cursor.fetchone()

    if seminar is None:
        messagebox.showerror("Error", "Seminar not found")
        cursor.close()
        db.close()
        return

    if seminar[0] <= 0:
        messagebox.showerror("Error", "No seats available")
        cursor.close()
        db.close()
        return

    query = """ INSERT INTO registrations (student_id, student_name, department, email, phone, seminar_id) VALUES (%s, %s, %s, %s, %s, %s) """

    cursor.execute(
        query,
        (student_id, student_name, department, email, phone, seminar_id)
    )

    # Reduce available seats
    cursor.execute(
        "UPDATE seminars SET seats = seats - 1 WHERE seminar_id = %s",
        (seminar_id,)
    )

    db.commit()

    cursor.close()
    db.close()

    messagebox.showinfo("Success", "Student registered successfully!")
    clear_registration_fields()


